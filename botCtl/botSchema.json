{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "type": "object",
    "properties": {
        "input": {
            "type": "string",
            "value": null,
            "comment": "User input text"
        },
        "session": {
            "type": "string",
            "value": null,
            "comment": "Session identifier for the conversation"
        },
        "sequence": {
            "type": "number",
            "value": null,
            "comment": "Sequence number within the session or conversation"
        },
        "lang": {
            "type": "string",
            "value": "de",
            "comment": "Language code for the conversation (default: 'de')"
        },
        "message":{
            "type": "object",
            "value": null,
            "comment": "Message content",
            "properties": {
                "text":{
                    "type":"string",
                    "value":"not null",
                    "comment":"Required text, in or out"
                }
            },
            "required": ["text"]
        },
        "state": {
            "type": "string",
            "value": null,
            "comment": "Opaque sealed conversation-state token (replaces context). Omitted for a new session."
        }
    },
    "required": [
        "session",
        "sequence",
        "lang",
        "message"
    ]
}